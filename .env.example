# Copy to .env (same directory as docker-compose.yml) and fill in your values.
# Used both for docker-compose ${VAR} substitution and as the container env_file.

# Polymarket wallet — this is the only credential needed. The bot's
# AsyncSecureClient (polymarket-client) derives its own API auth from this
# key and auto-detects the wallet type (EOA / proxy / Gnosis Safe / deposit
# wallet) on-chain, so no CLOB_API_KEY/SECRET/PASSPHRASE or SIGNATURE_TYPE
# config is needed.
PRIVATE_KEY=0x...

# Only needed if your Polymarket UI wallet address differs from the address
# derived from PRIVATE_KEY (true for most MetaMask/browser-wallet and email/
# Magic-login accounts, which trade through a proxy contract). Leave blank
# if you trade directly from a plain EOA with no proxy.
FUNDER_ADDRESS=

# Paper trading mode: "true" to simulate, "false" for real money
PAPER_TRADING=true

# Trade size in USD per trade
TRADE_SIZE_USD=1.0
MAX_DAILY_LOSS_USD=10000.0

# Starting balance shown on the dashboard (display only, not used in sizing/risk logic)
ACCOUNT_BALANCE_USD=10000.0

# Logging verbosity: DEBUG / INFO / WARNING
LOG_LEVEL=INFO
# Extra DEBUG for specific modules only (comma-separated), e.g. __main__ to see
# every skip reason. Warnings/errors always also go to errors.log.
LOG_DEBUG_MODULES=__main__

# Fixed password for the dashboard's "Pause/Resume Trading" button — blank
# means the button always rejects. Set this before relying on the feature.
TRADING_CONTROL_PASSWORD=

# Total USD ever deposited into the trading wallet, shown on the dashboard.
# No Polymarket API reports this — update by hand after each real deposit.
TOTAL_DEPOSITS_USD=0.0

# (The dashboard header's avatar is not configured here — drop a
#  pol-profile-pic.png in the repo root and it's served at /avatar.png.)

# BTC spot price feed source: binance | okx
BTC_PRICE_SOURCE=binance

# Feature toggles
STOP_LOSS_ENABLED=false
TAKE_PROFIT_ENABLED=false
PROXY_ENABLED=true
MIN_TIMING_FILTER_SCORE_ENABLED=true

# SQLite database file (relative to the working dir; /data in Docker)
SQLITE_PATH=polymarket_bot.db

# Fair-value model vs. the Chainlink window start price (filters/fair_value.py)
#   gate   = skip trades with edge < FAIR_VALUE_MIN_EDGE, odds score → edge score (default, paper + live)
#   shadow = only log fair prob / edge, never block
#   off    = disabled
FAIR_VALUE_MODE=gate
FAIR_VALUE_MIN_EDGE=0.03
# Per-share cost (taker fee etc.) subtracted from the edge — check Polymarket's current fees
FEE_PER_SHARE=0.0
