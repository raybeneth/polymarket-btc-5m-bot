# Copy to .env (same directory as docker-compose.yml) and fill in your values.
# Used both for docker-compose ${VAR} substitution and as the container env_file.

# Polymarket CLOB credentials (get from https://polymarket.com → API)
PRIVATE_KEY=0x...
CLOB_API_KEY=...
CLOB_API_SECRET=...
CLOB_API_PASSPHRASE=...

# Paper trading mode: "true" to simulate, "false" for real money
PAPER_TRADING=true

# Trade size in USD per trade
TRADE_SIZE_USD=1.0
MAX_DAILY_LOSS_USD=10000.0

# Starting balance shown on the dashboard (display only, not used in sizing/risk logic)
ACCOUNT_BALANCE_USD=10000.0

# Logging verbosity: DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# BTC spot price feed source: binance | okx
BTC_PRICE_SOURCE=binance

# Feature toggles
STOP_LOSS_ENABLED=false
TAKE_PROFIT_ENABLED=false
PROXY_ENABLED=true
MIN_TIMING_FILTER_SCORE_ENABLED=true

# MySQL — must match between the mysql and bot services
MYSQL_ROOT_PASSWORD=change_me
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=polymarket_bot
